# ============================================
# HAIGENT DEMO - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Haigent Demo

# ============================================
# SUPABASE (Required)
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# N8N WEBHOOKS - Agent Specific
# ============================================
# Each Haigent agent has its own webhook endpoints

# Schedule Haigent Webhooks
SCHEDULE_N8N_WEBHOOK_PROCESS_APPLICATION=http://localhost:5678/webhook/schedule/process-application
SCHEDULE_N8N_WEBHOOK_SEND_REMINDER=http://localhost:5678/webhook/schedule/send-reminder

# Sourcing Haigent Webhooks
SOURCING_N8N_WEBHOOK_SEARCH_CANDIDATES=http://localhost:5678/webhook/sourcing/search-candidates
SOURCING_N8N_WEBHOOK_ENRICH_PROFILE=http://localhost:5678/webhook/sourcing/enrich-profile

# Reference Haigent Webhooks
REFERENCE_N8N_WEBHOOK_REQUEST_REFERENCE=http://localhost:5678/webhook/reference/request-reference
REFERENCE_N8N_WEBHOOK_SEND_FOLLOWUP=http://localhost:5678/webhook/reference/send-followup

# Onboarding Haigent Webhooks
ONBOARDING_N8N_WEBHOOK_CREATE_ACCOUNT=http://localhost:5678/webhook/onboarding/create-account
ONBOARDING_N8N_WEBHOOK_SEND_WELCOME=http://localhost:5678/webhook/onboarding/send-welcome

# Benefits Haigent Webhooks
BENEFITS_N8N_WEBHOOK_ENROLL_BENEFIT=http://localhost:5678/webhook/benefits/enroll-benefit
BENEFITS_N8N_WEBHOOK_SEND_INFO=http://localhost:5678/webhook/benefits/send-info

# Payroll Haigent Webhooks
PAYROLL_N8N_WEBHOOK_PROCESS_PAYROLL=http://localhost:5678/webhook/payroll/process-payroll
PAYROLL_N8N_WEBHOOK_SEND_PAYSTUB=http://localhost:5678/webhook/payroll/send-paystub

# Engee Haigent Webhooks
ENGEE_N8N_WEBHOOK_LOG_ACTIVITY=http://localhost:5678/webhook/engee/log-activity
ENGEE_N8N_WEBHOOK_SEND_SURVEY=http://localhost:5678/webhook/engee/send-survey
